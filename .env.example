# Desarrollo local. Copiar a .env y sustituir el marcador; no versionar .env.
POSTGRES_DB=evaluacion
POSTGRES_USER=evaluacion
POSTGRES_PASSWORD=REEMPLAZAR_CON_UN_VALOR_LOCAL
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Solo para backend fuera de Docker: exportar POSTGRES_HOST/POSTGRES_PORT.
# Solo para frontend fuera de Docker:
API_INTERNAL_URL=http://127.0.0.1:8000

# Contraseña diferente para la API con permisos limitados.
RUNTIME_DB_PASSWORD=replace-with-another-random-secret
